        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha ancora la chiave. Verifica che il portachiavi iCloud sia attivo o ripristina un backup."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten har inte nyckeln än. Kontrollera att iCloud-nyckelring är på, eller återställ en säkerhetskopia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten har ikke nøkkelen ennå. Sjekk at iCloud-nøkkelring er på, eller gjenopprett en sikkerhetskopi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
