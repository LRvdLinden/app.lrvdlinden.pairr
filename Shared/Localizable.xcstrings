    "Add a device and its pairing code: scan it, read it from a photo or import your accessories from the Home app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a device and its pairing code: scan it, read it from a photo or import your accessories from the Home app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een apparaat en de koppelcode toe: scan hem, lees hem uit een foto of importeer je accessoires uit de Woning-app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Gerät und seinen Kopplungscode hinzu: scannen, aus einem Foto lesen oder deine Geräte aus der Home App importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un appareil et son code de jumelage : scannez-le, lisez-le sur une photo ou importez vos accessoires depuis l’app Maison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un dispositivo y su código de vinculación: escanéalo, léelo de una foto o importa tus accesorios desde la app Casa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un dispositivo e il suo codice di abbinamento: scansionalo, leggilo da una foto o importa i tuoi accessori dall’app Casa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en enhet och dess parkopplingskod: skanna den, läs den från ett foto eller importera dina tillbehör från Hem-appen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en enhet og sammenkoblingskoden: skann den, les den fra et bilde eller importer tilbehøret fra Hjem-appen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en enhed og dens parringskode: scan den, læs den fra et foto eller importer dit tilbehør fra Hjem-appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj urządzenie i jego kod parowania: zeskanuj go, odczytaj ze zdjęcia lub zaimportuj akcesoria z aplikacji Dom."
          }
        }
      }
    },
    "Add attachment": {
      "extractionState": "manual",
      "localizations": {
