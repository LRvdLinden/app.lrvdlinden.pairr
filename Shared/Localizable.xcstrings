    "Your devices and codes are coming back from iCloud. This can take a moment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices and codes are coming back from iCloud. This can take a moment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apparaten en codes komen terug uit iCloud. Dit kan even duren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Geräte und Codes kommen aus iCloud zurück. Das kann einen Moment dauern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos appareils et codes reviennent depuis iCloud. Cela peut prendre un moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus dispositivos y códigos están volviendo desde iCloud. Puede tardar un poco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dispositivi e codici stanno tornando da iCloud. Potrebbe volerci un attimo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina enheter och koder hämtas från iCloud. Det kan ta en stund."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhetene og kodene dine hentes fra iCloud. Det kan ta litt tid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine enheder og koder hentes fra iCloud. Det kan tage et øjeblik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje urządzenia i kody wracają z iCloud. To może chwilę potrwać."
          }
        }
      }
    },
    "Your homes, rooms and accessories, with re-paired devices recognised by serial number.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your homes, rooms and accessories, with re-paired devices recognised by serial number."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je woningen, kamers en accessoires, waarbij opnieuw gekoppelde apparaten op serienummer herkend worden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zuhause, deine Räume und Geräte, neu gekoppelte Geräte werden an der Seriennummer erkannt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos domiciles, pièces et accessoires, les appareils rejumelés étant reconnus par leur numéro de série."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus casas, habitaciones y accesorios, reconociendo por número de serie los dispositivos vinculados de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue case, stanze e accessori, con i dispositivi riabbinati riconosciuti dal numero di serie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina hem, rum och tillbehör, där enheter som kopplats om känns igen på serienumret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjemmene, rommene og tilbehøret ditt, der enheter som kobles til på nytt gjenkjennes på serienummeret."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine hjem, rum og tilbehør, hvor genparrede enheder genkendes på serienummeret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje domy, pokoje i akcesoria, a ponownie sparowane urządzenia są rozpoznawane po numerze seryjnym."
          }
        }
      }
    },
