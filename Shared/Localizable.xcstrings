    "Your Pairr data was found in iCloud and is being restored.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Pairr data was found in iCloud and is being restored."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Pairr-gegevens zijn in iCloud gevonden en worden teruggezet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pairr-Daten wurden in iCloud gefunden und werden wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données Pairr ont été trouvées dans iCloud et sont en cours de restauration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han encontrado tus datos de Pairr en iCloud y se están restaurando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati Pairr sono stati trovati in iCloud e vengono ripristinati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina Pairr-data hittades i iCloud och återställs."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr-dataene dine ble funnet i iCloud og gjenopprettes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine Pairr-data blev fundet i iCloud og gendannes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaleziono Twoje dane Pairr w iCloud i trwa ich przywracanie."
          }
        }
      }
    },
    "Your codes are encrypted and synced through your own iCloud. If you delete the app, everything comes back when you install it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your codes are encrypted and synced through your own iCloud. If you delete the app, everything comes back when you install it again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je codes worden versleuteld en via je eigen iCloud gesynchroniseerd. Verwijder je de app, dan komt alles terug als je hem opnieuw installeert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Codes werden verschlüsselt und über deine eigene iCloud synchronisiert. Löschst du die App, ist nach der Neuinstallation alles wieder da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos codes sont chiffrés et synchronisés via votre propre iCloud. Si vous supprimez l’app, tout revient quand vous la réinstallez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus códigos se cifran y se sincronizan con tu propio iCloud. Si eliminas la app, todo vuelve al reinstalarla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi codici sono cifrati e sincronizzati tramite il tuo iCloud. Se elimini l’app, tutto torna quando la reinstalli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina koder krypteras och synkas via din egen iCloud. Om du raderar appen kommer allt tillbaka när du installerar den igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodene dine krypteres og synkroniseres via din egen iCloud. Sletter du appen, kommer alt tilbake når du installerer den på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine koder krypteres og synkroniseres via din egen iCloud. Sletter du appen, kommer alt tilbage, når du installerer den igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje kody są szyfrowane i synchronizowane przez Twój iCloud. Jeśli usuniesz aplikację, wszystko wróci po ponownej instalacji."
          }
        }
      }
    },
