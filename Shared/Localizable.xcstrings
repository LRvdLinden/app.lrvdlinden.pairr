    "Keep every pairing code of your smart home in one place: HomeKit, Matter, Zigbee, Philips Hue and Z-Wave.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep every pairing code of your smart home in one place: HomeKit, Matter, Zigbee, Philips Hue and Z-Wave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar elke koppelcode van je slimme huis op één plek: HomeKit, Matter, Zigbee, Philips Hue en Z-Wave."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre jeden Kopplungscode deines Smart Homes an einem Ort auf: HomeKit, Matter, Zigbee, Philips Hue und Z-Wave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez tous les codes de jumelage de votre maison connectée au même endroit : HomeKit, Matter, Zigbee, Philips Hue et Z-Wave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda todos los códigos de vinculación de tu casa inteligente en un solo lugar: HomeKit, Matter, Zigbee, Philips Hue y Z-Wave."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva ogni codice di abbinamento della tua casa smart in un unico posto: HomeKit, Matter, Zigbee, Philips Hue e Z-Wave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara alla parkopplingskoder för ditt smarta hem på ett ställe: HomeKit, Matter, Zigbee, Philips Hue och Z-Wave."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta vare på alle sammenkoblingskodene i smarthjemmet ditt på ett sted: HomeKit, Matter, Zigbee, Philips Hue og Z-Wave."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem alle parringskoder fra dit smarte hjem ét sted: HomeKit, Matter, Zigbee, Philips Hue og Z-Wave."
          }
        },
        "pl": {
          "stringUnit": {
