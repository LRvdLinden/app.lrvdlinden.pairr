    "11 or 21 digits, or scan the QR code on the device or box.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "11 or 21 digits, or scan the QR code on the device or box."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "11 of 21 cijfers, of scan de QR-code op het apparaat of de doos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "11 oder 21 Ziffern, oder scanne den QR-Code auf dem Gerät oder der Verpackung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "11 ou 21 chiffres, ou scannez le QR code sur l’appareil ou la boîte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "11 o 21 dígitos, o escanea el código QR del dispositivo o la caja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "11 o 21 cifre, oppure scansiona il codice QR sul dispositivo o sulla confezione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "11 eller 21 siffror, eller skanna QR-koden på enheten eller kartongen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "11 eller 21 sifre, eller skann QR-koden på enheten eller esken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "11 eller 21 cifre, eller scan QR-koden på enheden eller æsken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "11 lub 21 cyfr albo zeskanuj kod QR na urządzeniu lub pudełku."
          }
        }
      }
    },
    "6 characters on the fitting of the bulb. Use it in the Hue app to add or reset a lamp by serial number.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6 characters on the fitting of the bulb. Use it in the Hue app to add or reset a lamp by serial number."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "6 tekens op de fitting van de lamp. Gebruik ze in de Hue-app om een lamp via het serienummer toe te voegen of te resetten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "6 Zeichen auf dem Sockel der Lampe. Damit fügst du in der Hue App eine Lampe per Seriennummer hinzu oder setzt sie zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "6 caractères sur le culot de l’ampoule. Utilisez-les dans l’app Hue pour ajouter ou réinitialiser une lampe par numéro de série."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "6 caracteres en el casquillo de la bombilla. Úsalos en la app Hue para añadir o restablecer una lámpara por número de serie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "6 caratteri sull’attacco della lampadina. Usali nell’app Hue per aggiungere o ripristinare una lampada tramite numero di serie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "6 tecken på lampans sockel. Använd dem i Hue-appen för att lägga till eller återställa en lampa via serienummer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "6 tegn på sokkelen til pæren. Bruk dem i Hue-appen for å legge til eller tilbakestille en lampe med serienummer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "6 tegn på pærens sokkel. Brug dem i Hue-appen til at tilføje eller nulstille en lampe via serienummer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "6 znaków na trzonku żarówki. Użyj ich w aplikacji Hue, aby dodać lub zresetować lampę po numerze seryjnym."
          }
        }
      }
    },
    "8 digits, on the sticker, the box or the manual.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8 digits, on the sticker, the box or the manual."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "8 cijfers, op de sticker, de doos of in de handleiding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "8 Ziffern, auf dem Aufkleber, der Verpackung oder in der Anleitung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "8 chiffres, sur l’étiquette, la boîte ou le manuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "8 dígitos, en la pegatina, la caja o el manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "8 cifre, sull’adesivo, sulla confezione o nel manuale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "8 siffror, på klistermärket, kartongen eller i manualen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "8 sifre, på klistremerket, esken eller i bruksanvisningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "8 cifre, på mærkatet, æsken eller i manualen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "8 cyfr, na naklejce, pudełku lub w instrukcji."
          }
        }
      }
    },
