    "Encrypted, in iCloud Drive → Pairr → Backups. The last 5 are kept. Tap a backup to restore devices that are missing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted, in iCloud Drive → Pairr → Backups. The last 5 are kept. Tap a backup to restore devices that are missing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versleuteld, in iCloud Drive → Pairr → Backups. De laatste 5 blijven bewaard. Tik op een back-up om ontbrekende apparaten terug te zetten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt, in iCloud Drive → Pairr → Backups. Die letzten 5 bleiben erhalten. Tippe auf ein Backup, um fehlende Geräte wiederherzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffrées, dans iCloud Drive → Pairr → Backups. Les 5 dernières sont conservées. Touchez une sauvegarde pour restaurer les appareils manquants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifradas, en iCloud Drive → Pairr → Backups. Se guardan las 5 últimas. Toca una copia para restaurar los dispositivos que faltan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrati, in iCloud Drive → Pairr → Backups. Vengono conservati gli ultimi 5. Tocca un backup per ripristinare i dispositivi mancanti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypterade, i iCloud Drive → Pairr → Backups. De senaste 5 sparas. Tryck på en säkerhetskopia för att återställa enheter som saknas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryptert, i iCloud Drive → Pairr → Backups. De siste 5 beholdes. Trykk på en sikkerhetskopi for å gjenopprette enheter som mangler."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypteret, i iCloud Drive → Pairr → Backups. De seneste 5 gemmes. Tryk på en sikkerhedskopi for at gendanne manglende enheder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaszyfrowane, w iCloud Drive → Pairr → Backups. Zachowywanych jest 5 ostatnich. Stuknij kopię, aby przywrócić brakujące urządzenia."
          }
        }
      }
    },
    "Enter the install code and IEEE address in your Zigbee hub or Zigbee2MQTT.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the install code and IEEE address in your Zigbee hub or Zigbee2MQTT."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul de install code en het IEEE-adres in bij je Zigbee-hub of Zigbee2MQTT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Installationscode und die IEEE-Adresse in deinem Zigbee-Hub oder Zigbee2MQTT ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code d’installation et l’adresse IEEE dans votre hub Zigbee ou Zigbee2MQTT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código de instalación y la dirección IEEE en tu hub Zigbee o Zigbee2MQTT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice di installazione e l’indirizzo IEEE nel tuo hub Zigbee o in Zigbee2MQTT."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange installationskoden och IEEE-adressen i din Zigbee-hubb eller Zigbee2MQTT."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn installasjonskoden og IEEE-adressen i Zigbee-huben eller Zigbee2MQTT."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast installationskoden og IEEE-adressen i din Zigbee-hub eller Zigbee2MQTT."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kod instalacyjny i adres IEEE w hubie Zigbee lub Zigbee2MQTT."
          }
        }
      }
    },
    "Everything is stored in your own iCloud. Deleting the app doesn't delete your data: after reinstalling, it comes back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is stored in your own iCloud. Deleting the app doesn't delete your data: after reinstalling, it comes back."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles staat in je eigen iCloud. Als je de app verwijdert, blijven je gegevens bewaard: na opnieuw installeren komen ze terug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird in deiner eigenen iCloud gespeichert. Wenn du die App löschst, bleiben deine Daten erhalten: Nach der Neuinstallation sind sie wieder da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est stocké dans votre propre iCloud. Supprimer l’app ne supprime pas vos données : elles reviennent après réinstallation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se guarda en tu propio iCloud. Eliminar la app no borra tus datos: vuelven al reinstalarla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto è salvato nel tuo iCloud. Eliminare l’app non cancella i dati: tornano dopo la reinstallazione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt lagras i din egen iCloud. Om du raderar appen finns datan kvar: den kommer tillbaka när du installerar igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt lagres i din egen iCloud. Sletter du appen, slettes ikke dataene: de kommer tilbake når du installerer på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt gemmes i din egen iCloud. Sletter du appen, bevares dine data: de kommer tilbage, når du geninstallerer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko jest przechowywane w Twoim iCloud. Usunięcie aplikacji nie usuwa danych: wrócą po ponownej instalacji."
          }
        }
      }
    },
