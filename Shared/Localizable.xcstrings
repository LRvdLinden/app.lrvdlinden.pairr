    "PDF, CSV and Markdown contain your codes as plain text. A Pairr backup is encrypted with your password and also works without iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF, CSV and Markdown contain your codes as plain text. A Pairr backup is encrypted with your password and also works without iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pdf, CSV en Markdown bevatten je codes als gewone tekst. Een Pairr-back-up is versleuteld met je wachtwoord en werkt ook zonder iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF, CSV und Markdown enthalten deine Codes als Klartext. Ein Pairr-Backup ist mit deinem Passwort verschlüsselt und funktioniert auch ohne iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les PDF, CSV et Markdown contiennent vos codes en clair. Une sauvegarde Pairr est chiffrée avec votre mot de passe et fonctionne aussi sans iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF, CSV y Markdown contienen tus códigos como texto sin cifrar. Una copia de Pairr se cifra con tu contraseña y funciona también sin iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF, CSV e Markdown contengono i codici in chiaro. Un backup Pairr è cifrato con la tua password e funziona anche senza iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF, CSV och Markdown innehåller dina koder som vanlig text. En Pairr-säkerhetskopia krypteras med ditt lösenord och fungerar även utan iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF, CSV og Markdown inneholder kodene som ren tekst. En Pairr-sikkerhetskopi er kryptert med passordet ditt og fungerer også uten iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF, CSV og Markdown indeholder dine koder som almindelig tekst. En Pairr-sikkerhedskopi er krypteret med din adgangskode og virker også uden iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF, CSV i Markdown zawierają kody jako zwykły tekst. Kopia Pairr jest szyfrowana Twoim hasłem i działa też bez iCloud."
          }
        }
      }
    },
