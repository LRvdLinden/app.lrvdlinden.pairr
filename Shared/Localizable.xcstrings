    "For devices with their own Wi-Fi network or setup hotspot.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For devices with their own Wi-Fi network or setup hotspot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor apparaten met een eigen wifi-netwerk of installatie-hotspot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Geräte mit eigenem WLAN oder Einrichtungs-Hotspot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les appareils avec leur propre réseau Wi-Fi ou point d’accès de configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dispositivos con su propia red wifi o punto de acceso de configuración."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per dispositivi con una propria rete Wi-Fi o hotspot di configurazione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För enheter med eget wifi-nätverk eller konfigurationshotspot."
          }
