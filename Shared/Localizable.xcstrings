    "Pairr copies the name, room, manufacturer and model. The setup codes themselves are not stored by HomeKit, so you add those afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr copies the name, room, manufacturer and model. The setup codes themselves are not stored by HomeKit, so you add those afterwards."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr neemt de naam, kamer, fabrikant en het model over. HomeKit bewaart de setup-codes zelf niet, dus die voeg je daarna toe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr übernimmt Name, Raum, Hersteller und Modell. Die Setup-Codes speichert HomeKit nicht, die fügst du danach hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr copie le nom, la pièce, le fabricant et le modèle. HomeKit ne conserve pas les codes eux-mêmes : ajoutez-les ensuite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr copia el nombre, la habitación, el fabricante y el modelo. HomeKit no guarda los códigos, así que los añades después."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr copia nome, stanza, produttore e modello. HomeKit non conserva i codici, quindi li aggiungi dopo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr kopierar namn, rum, tillverkare och modell. HomeKit sparar inte själva koderna, så dem lägger du till efteråt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr kopierer navn, rom, produsent og modell. HomeKit lagrer ikke selve kodene, så dem legger du til etterpå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr kopierer navn, rum, producent og model. HomeKit gemmer ikke selve koderne, så dem tilføjer du bagefter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairr kopiuje nazwę, pokój, producenta i model. HomeKit nie przechowuje kodów, więc dodasz je później."
          }
        }
      }
    },
