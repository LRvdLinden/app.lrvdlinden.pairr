          "stringUnit": {
            "state": "translated",
            "value": "De codes en bijlagen worden op al je apparaten verwijderd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Codes und Anhänge werden auf all deinen Geräten gelöscht."
