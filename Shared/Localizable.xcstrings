    "For example the IP address, MAC address or the hub it's paired with.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example the IP address, MAC address or the hub it's paired with."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijvoorbeeld het IP-adres, MAC-adres of de hub waaraan het gekoppeld is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel die IP-Adresse, die MAC-Adresse oder der Hub, mit dem es gekoppelt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple l’adresse IP, l’adresse MAC ou le hub auquel il est jumelé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo, la dirección IP, la dirección MAC o el hub al que está vinculado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad esempio l’indirizzo IP, l’indirizzo MAC o l’hub a cui è abbinato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till exempel IP-adressen, MAC-adressen eller hubben den är kopplad till."
          }
        },
        "nb": {
