    "Deletes all devices and codes on all your devices and in iCloud. Backups in iCloud Drive stay unless you choose otherwise.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes all devices and codes on all your devices and in iCloud. Backups in iCloud Drive stay unless you choose otherwise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist alle apparaten en codes op al je apparaten en in iCloud. Back-ups in iCloud Drive blijven, tenzij je anders kiest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle Geräte und Codes auf all deinen Geräten und in iCloud. Backups in iCloud Drive bleiben erhalten, außer du wählst etwas anderes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime tous les appareils et codes sur tous vos appareils et dans iCloud. Les sauvegardes d’iCloud Drive restent, sauf si vous choisissez autrement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todos los dispositivos y códigos en todos tus dispositivos y en iCloud. Las copias de iCloud Drive se conservan salvo que elijas lo contrario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutti i dispositivi e i codici su tutti i tuoi dispositivi e in iCloud. I backup su iCloud Drive restano, a meno che tu non scelga diversamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar alla enheter och koder på alla dina enheter och i iCloud. Säkerhetskopior i iCloud Drive finns kvar om du inte väljer annat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter alle enheter og koder på alle enhetene dine og i iCloud. Sikkerhetskopier i iCloud Drive blir værende med mindre du velger noe annet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter alle enheder og koder på alle dine enheder og i iCloud. Sikkerhedskopier i iCloud Drive bevares, medmindre du vælger andet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa wszystkie urządzenia i kody na wszystkich Twoich urządzeniach i w iCloud. Kopie na iCloud Drive zostają, chyba że wybierzesz inaczej."
          }
        }
      }
    },
