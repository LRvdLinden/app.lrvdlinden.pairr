    "Codes and photos are encrypted, synced through iCloud and backed up weekly to iCloud Drive.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes and photos are encrypted, synced through iCloud and backed up weekly to iCloud Drive."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes en foto’s worden versleuteld, via iCloud gesynchroniseerd en elke week naar iCloud Drive geback-upt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes und Fotos werden verschlüsselt, über iCloud synchronisiert und wöchentlich in iCloud Drive gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes et photos sont chiffrés, synchronisés via iCloud et sauvegardés chaque semaine sur iCloud Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos y las fotos se cifran, se sincronizan con iCloud y se copian cada semana en iCloud Drive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codici e foto sono cifrati, sincronizzati tramite iCloud e salvati ogni settimana su iCloud Drive."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koder och foton krypteras, synkas via iCloud och säkerhetskopieras varje vecka till iCloud Drive."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koder og bilder krypteres, synkroniseres via iCloud og sikkerhetskopieres ukentlig til iCloud Drive."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koder og fotos krypteres, synkroniseres via iCloud og sikkerhedskopieres ugentligt til iCloud Drive."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kody i zdjęcia są szyfrowane, synchronizowane przez iCloud i co tydzień kopiowane na iCloud Drive."
          }
        }
      }
    },
