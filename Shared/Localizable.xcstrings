    "The lock uses Face ID, Touch ID or your passcode. With “Show codes right away” off, codes stay hidden until you tap them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock uses Face ID, Touch ID or your passcode. With “Show codes right away” off, codes stay hidden until you tap them."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergrendeling gebruikt Face ID, Touch ID of je toegangscode. Staat “Codes direct tonen” uit, dan blijven codes verborgen tot je erop tikt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sperre nutzt Face ID, Touch ID oder deinen Code. Ist „Codes sofort zeigen“ aus, bleiben Codes verborgen, bis du darauf tippst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrouillage utilise Face ID, Touch ID ou votre code. Si « Afficher les codes directement » est désactivé, les codes restent masqués jusqu’à ce que vous les touchiez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo usa Face ID, Touch ID o tu código. Con “Mostrar códigos directamente” desactivado, los códigos quedan ocultos hasta que los tocas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco usa Face ID, Touch ID o il codice. Con “Mostra subito i codici” disattivato, i codici restano nascosti finché non li tocchi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låset använder Face ID, Touch ID eller din lösenkod. Med ”Visa koder direkt” av är koderna dolda tills du trycker på dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Låsen bruker Face ID, Touch ID eller koden din. Med «Vis koder med en gang» av er kodene skjult til du trykker på dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Låsen bruger Face ID, Touch ID eller din kode. Med “Vis koder med det samme” slået fra er koderne skjult, til du trykker på dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokada używa Face ID, Touch ID lub kodu. Gdy „Pokazuj kody od razu” jest wyłączone, kody są ukryte, dopóki ich nie stukniesz."
          }
        }
      }
    },
