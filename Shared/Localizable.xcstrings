    "This device doesn't have the key yet. Check that iCloud Keychain is on, or restore a backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device doesn't have the key yet. Check that iCloud Keychain is on, or restore a backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat heeft de sleutel nog niet. Controleer of de iCloud-sleutelhanger aanstaat, of zet een back-up terug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat den Schlüssel noch nicht. Prüfe, ob der iCloud-Schlüsselbund aktiv ist, oder stelle ein Backup wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas encore la clé. Vérifiez que le trousseau iCloud est activé, ou restaurez une sauvegarde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo aún no tiene la clave. Comprueba que el llavero de iCloud esté activado o restaura una copia."
