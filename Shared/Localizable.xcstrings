    "Large and bright, so you can pair a device straight from Pairr or your Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large and bright, so you can pair a device straight from Pairr or your Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groot en helder, zodat je een apparaat direct vanuit Pairr of je Apple Watch koppelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Groß und hell, damit du ein Gerät direkt aus Pairr oder auf der Apple Watch koppeln kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En grand et lumineux, pour jumeler un appareil directement depuis Pairr ou votre Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grande y brillante, para vincular un dispositivo directamente desde Pairr o tu Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grande e luminoso, per abbinare un dispositivo direttamente da Pairr o dall’Apple Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stort och ljust, så att du kan koppla en enhet direkt från Pairr eller din Apple Watch."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stort og lyst, så du kan koble til en enhet rett fra Pairr eller Apple Watch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stort og lyst, så du kan parre en enhed direkte fra Pairr eller dit Apple Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duży i jasny, aby sparować urządzenie prosto z Pairr lub Apple Watch."
          }
        }
      }
    },
