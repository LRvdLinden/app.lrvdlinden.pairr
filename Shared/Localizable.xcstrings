    "A photo of the sticker, the manual or where the device is in your home.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A photo of the sticker, the manual or where the device is in your home."
          }
        },
        "nl": {
